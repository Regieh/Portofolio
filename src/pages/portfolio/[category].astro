---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { CATEGORIES, SITE_TITLE } from "../../consts";

export function getStaticPaths() {
	return CATEGORIES.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const posts = (await getCollection("project"))
	.filter((post) => post.data.category === category.key)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${category.label} · ${SITE_TITLE}`} description={category.blurb} />
		<style>
			main {
				width: 1100px;
			}
			.intro {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2.5rem;
			}
			.intro h1 {
				margin: 0.4rem 0 0;
			}
			.intro p {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro" data-reveal>
				<div>
					<p class="eyebrow">Portfolio</p>
					<h1>{category.label}</h1>
				</div>
				<p>{category.blurb} · {posts.length} {posts.length === 1 ? "project" : "projects"}</p>
			</div>
			<ProjectGrid posts={posts} />
		</main>
		<Footer />
	</body>
</html>
