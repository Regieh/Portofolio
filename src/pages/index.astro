---
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Narrative from '../components/Narrative.astro';
import Object3D from '../components/Object3D.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE, SiteIcon } from '../consts';
import showcase from '../assets/about/game-institute/unfolded-showcase.png';

const projects = await getCollection('project');
const countFor = (key: string) => {
	const count = projects.filter((p) => p.data.category === key).length;
	return `${count} ${count === 1 ? 'project' : 'projects'}`;
};
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ---------- Hero: sticky stage, object turns as you scroll ---------- */
			/* Exactly one screen under the sticky header */
			.hero-stage {
				position: relative;
				/* The home header floats over the hero, so it gets the full screen */
				height: 100svh;
				min-height: 34rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				grid-template-rows: 1fr auto;
				padding: clamp(1rem, 2.5vw, 1.75rem) var(--gutter) 2rem;
				overflow: hidden;
			}
			.hero-title {
				grid-column: 1;
				grid-row: 1;
				align-self: start;
			}
			/* Name: chunky grotesque + italic serif, like a wordmark */
			.hero-title h1 {
				margin: 0;
				font-size: clamp(3rem, 7.4vw, 6.4rem);
				font-weight: 800;
				line-height: 0.88;
				letter-spacing: -0.05em;
			}
			.hero-title h1 em {
				display: block;
				margin-left: 0.04em;
				font-size: 1.08em;
				letter-spacing: -0.02em;
			}
			.hero-tags {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4rem 1rem;
				margin-top: 1.5rem;
				font-size: 1.1rem;
				font-weight: 500;
			}
			.hero-tags a {
				color: var(--color-primary);
				text-decoration: underline;
				text-decoration-color: transparent;
				text-decoration-thickness: 2px;
				text-underline-offset: 0.3em;
				transition: text-decoration-color 0.25s ease, color 0.25s ease;
			}
			.hero-tags a:hover {
				color: var(--color-accent);
				text-decoration-color: currentColor;
			}
			.hero-tags .sep {
				color: var(--color-muted);
				font-size: 0.8em;
			}
			.hero-object {
				grid-column: 2;
				grid-row: 1 / -1;
				align-self: center;
			}
			.hero-details {
				grid-column: 1;
				grid-row: 2;
				align-self: end;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				line-height: 1.4;
				font-weight: 500;
			}
			.hero-details p {
				margin: 0 0 1rem;
				color: var(--color-primary);
			}
			/* Category cards: tidy, aligned, rounded. Hover lifts one gently. */
			.hero-categories {
				grid-column: 3;
				grid-row: 2;
				align-self: end;
				justify-self: end;
				display: grid;
				grid-template-columns: repeat(3, clamp(7.5rem, 9.5vw, 10.5rem));
				gap: 0.75rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.cat-item {
				animation: card-in 0.8s var(--ease-out) both;
				animation-delay: calc(300ms + var(--i) * 100ms);
			}
			@keyframes card-in {
				from {
					opacity: 0;
					translate: 0 24px;
				}
			}
			.cat-link {
				display: block;
				padding: 0.4rem 0.4rem 0.7rem;
				border-radius: var(--radius);
				background: var(--paper-raised);
				box-shadow: 0 1px 0 rgba(var(--ink-rgb), 0.04), 0 0 0 1px rgba(var(--ink-rgb), 0.06);
				color: var(--ink);
				text-decoration: none;
				transition:
					translate 0.45s var(--ease-spring),
					box-shadow 0.3s ease;
			}
			.cat-link:hover {
				color: var(--ink);
				translate: 0 -6px;
				box-shadow: 0 18px 30px -18px rgba(var(--ink-rgb), 0.45), 0 0 0 1px rgba(var(--ink-rgb), 0.08);
			}
			.cat-photo {
				position: relative;
				display: block;
				aspect-ratio: 4 / 5;
				overflow: hidden;
				border-radius: calc(var(--radius) - 0.4rem);
				background: var(--image-frame);
			}
			.cat-photo :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: scale 0.6s var(--ease-out);
			}
			.cat-link:hover .cat-photo :global(img) {
				scale: 1.06;
			}
			.cat-name {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.25rem;
				margin-top: 0.6rem;
				padding: 0 0.3rem;
				font-size: 0.95rem;
				font-weight: 600;
				white-space: nowrap;
			}
			.cat-name sup {
				margin-left: 0.15rem;
				font-family: var(--font-mono);
				font-size: 0.6rem;
				font-weight: 400;
				color: var(--color-muted);
			}
			.cat-name :global(svg) {
				transition: translate 0.35s var(--ease-spring);
			}
			.cat-link:hover .cat-name :global(svg) {
				translate: 3px 0;
			}

			/* ---------- Statement ---------- */
			.statement {
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				gap: var(--gutter);
				align-items: end;
				padding: clamp(3rem, 8vw, 6rem) var(--gutter);
			}
			.statement h2 {
				margin: 0;
				font-size: clamp(2rem, 4.4vw, 3.6rem);
				line-height: 1;
			}
			.statement-body {
				max-width: 34rem;
				font-size: 1rem;
			}

			/* ---------- Dark band of categories (Kyoto "Programme") ---------- */
			.band {
				margin: 0 var(--gutter) clamp(3rem, 7vw, 5rem);
				border-radius: var(--radius-lg);
				background: var(--ink-band);
				color: var(--paper);
				padding: clamp(1.5rem, 4vw, 2.5rem);
			}
			.band-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.75rem;
			}
			.band-head h2 {
				margin: 0;
				color: var(--paper);
				font-size: clamp(1.8rem, 3.4vw, 2.6rem);
			}
			.band-head p {
				margin: 0;
				color: var(--on-band-muted);
				font-size: 0.8rem;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}
			.card {
				position: relative;
				display: flex;
				flex-direction: column;
				padding: 0.6rem 0.6rem 1rem;
				border-radius: var(--radius);
				background: var(--paper);
				color: var(--ink);
				text-decoration: none;
				overflow: hidden;
			}
			.card:hover {
				color: var(--ink);
			}
			.card h3 {
				margin: 0;
				font-size: 1.35rem;
			}
			.card .sub {
				margin: 0.1rem 0 0;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-muted);
			}
			.card-head {
				padding: 0.9rem 0.5rem 0;
			}
			.card .media {
				position: relative;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				border-radius: calc(var(--radius) - 0.6rem);
				background: var(--image-frame);
			}
			.card .media :global(img) {
				width: 108%;
				max-width: none;
				height: 108%;
				margin: -4%;
				object-fit: cover;
				transform: translate(calc(var(--px) * -18px), calc(var(--py) * -18px));
				transition: transform 0.6s var(--ease-out);
			}
			.card .more {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-top: 1.25rem;
				padding: 0 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
			}
			.card .more :global(svg) {
				transition: transform 0.3s var(--ease-out);
			}
			.card:hover .more :global(svg) {
				transform: translateX(4px);
			}

			@media (max-width: 860px) {
				.hero-stage {
					height: auto;
					min-height: 100svh;
					padding-top: 5rem;
					grid-template-columns: 1fr;
					grid-template-rows: auto 1fr auto auto;
					row-gap: 1.5rem;
				}
				.hero-object {
					grid-column: 1;
					grid-row: 2;
					justify-self: center;
					align-self: center;
				}
				.hero-details {
					grid-column: 1;
					grid-row: 3;
				}
				.hero-categories {
					grid-column: 1;
					grid-row: 4;
					justify-self: stretch;
					grid-template-columns: repeat(3, 1fr);
					gap: 0.5rem;
					margin: 0.5rem 0 1rem;
				}
				.cat-name {
					font-size: 0.8rem;
				}
				.statement {
					grid-template-columns: 1fr;
				}
				.cards {
					grid-template-columns: repeat(3, 78%);
					overflow-x: auto;
					scroll-snap-type: x mandatory;
					padding-bottom: 0.5rem;
				}
				.card {
					scroll-snap-align: start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="width: auto; padding: 0;">
			<section class="hero">
				<div class="hero-stage">
					<div class="hero-title">
						<h1>Raphael <em>Gregorius</em></h1>
						<nav class="hero-tags" aria-label="Categories">
							{['games', 'web', 'apps'].map((slug, i) => {
								const category = CATEGORIES.find((c) => c.slug === slug)!;
								return (
									<>
										{i > 0 && <span class="sep" aria-hidden="true">•</span>}
										<a href={`/portfolio/${category.slug}/`}>{category.label}</a>
									</>
								);
							})}
						</nav>
					</div>

					<div class="hero-object">
						<Object3D icon={SiteIcon} />
					</div>

					<div class="hero-details">
						<p>
							Currently<br />
							Apple Developer Academy<br />
							<mark>Game Institute</mark>
						</p>
						<p>
							Unfolded · PattyPaw<br />
							<mark>Catmouflage</mark> (TestFlight)
						</p>
					</div>

					<ul class="hero-categories" aria-label="Browse by category">
						{['games', 'web', 'apps'].map((slug, i) => {
							const category = CATEGORIES.find((c) => c.slug === slug)!;
							const count = projects.filter((p) => p.data.category === category.key).length;
							return (
								<li class="cat-item" style={`--i: ${i}`}>
									<a class="cat-link" href={`/portfolio/${category.slug}/`}>
										<span class="cat-photo">
											<Image src={category.cover} width={360} alt="" />
										</span>
										<span class="cat-name">
											<span>
												{category.label}
												<sup>{count}</sup>
											</span>
											<ArrowRight size={14} aria-hidden="true" />
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>

			<section class="statement">
				<h2 data-reveal>I build apps, games and websites <em>people enjoy using.</em></h2>
				<div class="statement-body" data-reveal style="--reveal-delay: 120">
					<p>
						A <mark>Distinction</mark> Computer Science graduate working across iOS development, backend engineering,
						machine learning and full-stack web, through Apple Developer Academy, Paper.id and Bangkit.
					</p>
					<p>
						Now in my second year at the Academy’s <mark>Game Institute</mark>, making games: from Unfolded and
						PattyPaw to Catmouflage, currently in TestFlight.
					</p>
				</div>
			</section>

			<Narrative
				word="Play"
				caption="Showcase day: Unfolded & Shape Shift, Apple Developer Academy"
				image={showcase}
				alt="Unfolded and Shape Shift on display at the Academy showcase"
			/>

			<section class="band" aria-labelledby="portfolio-heading">
				<div class="band-head">
					<h2 id="portfolio-heading">The <em>portfolio</em></h2>
					<p>{projects.length} projects</p>
				</div>
				<div class="cards">
					{CATEGORIES.map((category, i) => (
						<div data-reveal style={`--reveal-delay: ${i * 120}`}>
							<a class="card" href={`/portfolio/${category.slug}/`} data-tilt="6">
								<div class="media">
									<Image src={category.cover} width={700} alt="" />
								</div>
								<div class="card-head">
									<h3>{category.label}</h3>
									<p class="sub">{category.blurb}</p>
								</div>
								<span class="more">
									{countFor(category.key)} <ArrowRight size={16} aria-hidden="true" />
								</span>
								<span class="glare" aria-hidden="true" />
							</a>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
