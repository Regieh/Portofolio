---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1100px;
			}
			.intro {
				margin-bottom: 3rem;
			}
			.intro h1 {
				margin: 0.4rem 0 0;
			}
			/* Alternating rows: picture and text swap sides every other post */
			ul {
				display: grid;
				gap: clamp(2.5rem, 6vw, 4.5rem);
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.row {
				display: grid;
				grid-template-columns: 1.25fr 1fr;
				align-items: center;
				gap: clamp(1.5rem, 4vw, 3.5rem);
			}
			.row.flip {
				grid-template-columns: 1fr 1.25fr;
			}
			.row.flip .media {
				order: 2;
			}
			.media {
				position: relative;
				display: block;
				aspect-ratio: 3 / 2;
				overflow: hidden;
				border-radius: var(--radius-lg);
				background: var(--image-frame);
			}
			.media :global(.backdrop) {
				position: absolute;
				inset: -10%;
				width: 120%;
				max-width: none;
				height: 120%;
				object-fit: cover;
				filter: blur(28px) saturate(1.3);
				opacity: 0.85;
			}
			.media :global(.shot) {
				position: absolute;
				inset: 7%;
				width: 86%;
				height: 86%;
				object-fit: contain;
				border-radius: var(--radius-sm);
				filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.35));
				transition: scale 0.6s var(--ease-out);
			}
			.media:hover :global(.shot) {
				scale: 1.04;
			}
			.date {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-muted);
			}
			.title {
				margin: 0 0 0.75rem;
				font-size: clamp(1.6rem, 3vw, 2.4rem);
			}
			.title a {
				color: var(--color-primary);
				text-decoration: none;
			}
			.title a:hover {
				color: var(--color-accent);
			}
			.description {
				margin: 0 0 1.5rem;
				font-size: 1.02rem;
			}
			.cta {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.55rem 1.1rem;
				border-radius: 999px;
				background: var(--ink);
				color: var(--paper);
				font-weight: 600;
				font-size: 0.9rem;
				text-decoration: none;
				transition: translate 0.4s var(--ease-spring);
			}
			.cta:hover {
				color: var(--paper);
				translate: 0 -2px;
			}
			.cta :global(svg) {
				transition: translate 0.35s var(--ease-spring);
			}
			.cta:hover :global(svg) {
				translate: 3px 0;
			}
			@media (max-width: 760px) {
				.row,
				.row.flip {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
				.row.flip .media {
					order: 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="intro" data-reveal>
				<p class="eyebrow">Blog</p>
				<h1>Things I <em>learn</em><br />along the way.</h1>
			</div>
			<ul>
				{
					posts.map((post, i) => (
						<li class:list={["row", { flip: i % 2 === 1 }]} data-reveal>
							<a class="media" href={`/blog/${post.id}/`} data-tilt="4" tabindex="-1" aria-hidden="true">
								{post.data.heroImage && (
									<>
										{/* Blurred copy fills the stage; the real image sits on top, uncropped */}
										<Image class="backdrop" src={post.data.heroImage} width={120} alt="" />
										<Image class="shot" src={post.data.heroImage} width={1200} alt="" />
									</>
								)}
								<span class="glare" />
							</a>
							<div class="text">
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2 class="title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="description">{post.data.description}</p>
								<a class="cta" href={`/blog/${post.id}/`}>
									Read post <ArrowRight size={16} aria-hidden="true" />
								</a>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
