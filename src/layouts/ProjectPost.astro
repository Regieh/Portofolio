---
import { CATEGORIES } from '../consts';
import Article from './Article.astro';

const { title, description, pubDate, updatedDate, heroImage, techStack, category, headings } = Astro.props;
const categoryInfo = CATEGORIES.find((c) => c.key === category);
---

<Article
	{title}
	{description}
	{pubDate}
	{updatedDate}
	{heroImage}
	{techStack}
	{headings}
	back={categoryInfo && { label: categoryInfo.label, href: `/portfolio/${categoryInfo.slug}/` }}
>
	<slot />
</Article>
