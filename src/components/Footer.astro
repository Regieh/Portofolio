---
import { Mail } from '@lucide/astro';
import { EMAIL, GITHUB_URL, INSTAGRAM_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import SocialIcon from './SocialIcon.astro';

const socials = [
	{ name: 'instagram', label: 'Instagram', href: INSTAGRAM_URL },
	{ name: 'linkedin', label: 'LinkedIn', href: LINKEDIN_URL },
	{ name: 'github', label: 'GitHub', href: GITHUB_URL },
] as const;
---

<footer class="site-footer">
	<div>
		{SITE_TITLE}<br />Software Engineer
	</div>
	<div>
		<a class="social" href={`mailto:${EMAIL}`}><Mail size={15} aria-hidden="true" />{EMAIL}</a>
	</div>
	<div>
		<p class="find">Find me somewhere else:</p>
		<div class="socials">
			{socials.map((s) => (
				<a class="social" href={s.href} target="_blank" rel="noopener">
					<SocialIcon name={s.name} size={15} />
					{s.label}
				</a>
			))}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		padding: 2rem var(--gutter) 2.5rem;
		border-top: var(--rule);
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--color-primary);
	}
	.site-footer > :nth-child(2) {
		text-align: center;
	}
	.site-footer > :last-child {
		text-align: right;
	}
	.find {
		margin: 0 0 0.6rem;
		color: var(--color-primary);
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.4rem;
	}
	/* Icon + label pills */
	.social {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		background: var(--paper-raised);
		box-shadow: inset 0 0 0 1px var(--color-border);
		color: var(--color-primary);
		font-weight: 500;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease, translate 0.35s var(--ease-spring);
	}
	.social:hover {
		background: var(--ink);
		color: var(--paper);
		translate: 0 -2px;
	}
	.social :global(svg) {
		flex-shrink: 0;
	}
	@media (max-width: 720px) {
		.site-footer {
			grid-template-columns: 1fr;
		}
		.site-footer > * {
			text-align: left !important;
		}
		.socials {
			justify-content: flex-start;
		}
	}
</style>
