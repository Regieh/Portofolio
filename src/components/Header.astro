---
import { ChevronDown } from '@lucide/astro';
import { CATEGORIES, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// On the home page the hero already shows the name big, so the header
// becomes just a floating nav pill over the page.
const isHome = Astro.url.pathname === '/';
---

<header class:list={['site-header', { floating: isHome }]}>
	<nav>
		{!isHome && <a href="/" class="site-title">{SITE_TITLE}</a>}

		<div class="internal-links">
			<div class="dropdown">
				<HeaderLink href="/" match={['', 'portfolio', 'project']} aria-haspopup="true">
					Portfolio <ChevronDown class="chevron" size={14} aria-hidden="true" />
				</HeaderLink>
				<ul class="menu">
					{CATEGORIES.map((category) => (
						<li><a href={`/portfolio/${category.slug}/`}>{category.label}</a></li>
					))}
				</ul>
			</div>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		box-sizing: border-box;
		height: var(--header-h);
		display: flex;
		align-items: center;
		padding: 0 var(--gutter);
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: saturate(160%) blur(16px);
		-webkit-backdrop-filter: saturate(160%) blur(16px);
		font-size: 1rem;
	}

	/* Home: no bar, no name; the nav pill floats top right */
	.site-header.floating {
		position: fixed;
		inset: 0 0 auto;
		height: auto;
		padding-top: clamp(1rem, 2.5vw, 1.75rem);
		background: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		pointer-events: none;
	}

	.site-header.floating nav {
		justify-content: flex-end;
	}

	.site-header.floating .internal-links {
		pointer-events: auto;
		box-shadow:
			inset 0 0 0 1px var(--color-border),
			0 10px 30px -18px rgba(var(--ink-rgb), 0.35);
	}

	nav {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-title {
		white-space: nowrap;
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--color-primary);
		text-decoration: none;
	}

	/* Links sit in one soft pill; the current page is a filled pill */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.3rem;
		border-radius: 999px;
		background: var(--paper-raised);
		box-shadow: inset 0 0 0 1px var(--color-border);
	}

	.dropdown {
		position: relative;
	}

	.dropdown :global(.chevron) {
		display: inline;
		vertical-align: -2px;
		transition: transform 0.25s var(--ease-out);
	}

	.dropdown:hover :global(.chevron),
	.dropdown:focus-within :global(.chevron) {
		transform: rotate(180deg);
	}

	/* Menu shows on hover or keyboard focus; no JS needed */
	.menu {
		position: absolute;
		top: calc(100% + 0.6rem);
		left: -0.75rem;
		z-index: 30;
		min-width: 9rem;
		margin: 0;
		padding: 0.4rem 0;
		list-style: none;
		background: var(--paper-raised);
		border-radius: var(--radius);
		box-shadow: 0 18px 40px -20px rgba(var(--ink-rgb), 0.35), 0 0 0 1px var(--color-border);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
	}

	/* Bridge the gap so the menu doesn't close while moving to it */
	.menu::before {
		content: '';
		position: absolute;
		inset: -0.7rem 0 auto;
		height: 0.7rem;
	}

	.dropdown:hover .menu,
	.dropdown:focus-within .menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.menu a {
		display: block;
		margin: 0 0.3rem;
		padding: 0.4rem 0.7rem;
		border-radius: var(--radius-sm);
		color: var(--color-primary);
		text-decoration: none;
	}

	.menu a:hover,
	.menu a:focus-visible {
		background: var(--ink);
		color: var(--paper);
	}

	@media (max-width: 720px) {
		.site-header {
			font-size: 0.85rem;
		}
		.site-title {
			font-size: 0.95rem;
			letter-spacing: -0.03em;
		}
		.menu {
			display: none;
		}
	}
</style>
