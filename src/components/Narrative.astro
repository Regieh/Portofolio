---
// MOX-style editorial moment: a full-bleed picture with a huge wide word
// sitting on its bottom edge and a small serif caption on top.
// Add `quote` (+ `cite`) to place a quote or reference underneath.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Huge word over the picture, keep it short (3–6 letters reads best). */
	word: string;
	caption: string;
	image?: ImageMetadata;
	/** Path under public/, e.g. /videos/clip.mp4 */
	video?: string;
	poster?: string;
	alt?: string;
	/** Small label such as "01" or "Notes". */
	index?: string;
	quote?: string;
	cite?: string;
	/** Focal point for cropping, CSS object-position. */
	focus?: string;
}

const { word, caption, image, video, poster, alt = '', index, quote, cite, focus = 'center' } = Astro.props;
// Scale the word so it spans the width whatever its length.
const wordSize = Math.min(24, 96 / (word.length * 0.98));
---

<section class="narrative">
	<figure class="frame" data-reveal>
		{image && <Image src={image} widths={[800, 1400, 2000]} sizes="100vw" alt={alt} style={`object-position: ${focus}`} />}
		{video && (
			<video src={video} poster={poster} autoplay muted loop playsinline aria-label={alt} style={`object-position: ${focus}`} />
		)}
		<figcaption class="caption">{caption}</figcaption>
		<p class="word display" aria-hidden="true" style={`--word-size: ${wordSize}vw`}>{word}</p>
	</figure>

	{quote && (
		<div class="quote-row" data-reveal>
			<p class="eyebrow">{index ?? 'Note'}</p>
			<blockquote>
				<p>{quote}</p>
				{cite && <cite>{cite}</cite>}
			</blockquote>
		</div>
	)}
</section>

<style>
	.narrative {
		padding: 0 0 clamp(3rem, 8vw, 6rem);
	}

	.frame {
		position: relative;
		margin: 0 var(--gutter);
		border-radius: var(--radius-lg);
		height: min(92vh, 62vw + 20rem);
		overflow: hidden;
		background: var(--ink);
	}

	.frame :global(img),
	.frame video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Soft shade so the caption and word stay legible */
	.frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgba(0, 0, 0, 0.35), transparent 22%),
			linear-gradient(to top, rgba(0, 0, 0, 0.25), transparent 35%);
		pointer-events: none;
	}

	.caption {
		position: absolute;
		z-index: 1;
		top: 1.5rem;
		left: 50%;
		width: min(22rem, 80%);
		transform: translateX(-50%);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.05;
		text-align: center;
		text-transform: uppercase;
		color: #fff;
	}

	.word {
		position: absolute;
		z-index: 1;
		left: 0;
		right: 0;
		bottom: 0;
		margin: 0;
		font-size: var(--word-size);
		text-align: center;
		color: #fff;
		/* Sit the baseline right on the picture's bottom edge */
		transform: translateY(0.08em);
		transition: transform 1.2s var(--ease-out);
	}

	:global(.js) .frame:not(.is-visible) .word {
		transform: translateY(0.6em);
	}

	.quote-row {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: var(--gutter);
		max-width: 1100px;
		margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
		padding: 0 var(--gutter);
	}

	.quote-row blockquote {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.quote-row blockquote p {
		margin: 0;
		color: var(--color-primary);
		font-size: clamp(1.6rem, 3.6vw, 2.8rem);
		line-height: 1.1;
	}

	.quote-row cite {
		display: block;
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-style: normal;
		color: var(--color-muted);
	}

	@media (max-width: 720px) {
		.frame {
			height: 75vh;
		}
		.quote-row {
			grid-template-columns: 1fr;
		}
	}
</style>
